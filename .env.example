# Shared local-development configuration for every service (copy to .env).
# Each service reads only the variables it needs.
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://evently:evently@localhost:5432/evently
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# Shared secret between the gateway and services (service-to-service auth).
INTERNAL_API_TOKEN=local-internal-token-change-me
# Shared between auth-service (issues tokens) and gateway (verifies them).
JWT_SECRET=local-jwt-secret-change-me-please
JWT_EXPIRES_IN=12h

# Bootstrap admin, created/promoted by auth-service on startup.
ADMIN_EMAIL=admin@evently.dev
ADMIN_PASSWORD=admin12345

# Service locations (used by the gateway and by catalog → booking calls).
AUTH_SERVICE_URL=http://localhost:4001
CATALOG_SERVICE_URL=http://localhost:4002
BOOKING_SERVICE_URL=http://localhost:4003
NOTIFY_SERVICE_URL=http://localhost:4004

RATE_LIMIT_ENABLED=true
CORS_ORIGINS=*
